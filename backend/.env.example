# ============================================
# BuildMyHome (Planova) - Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# cp .env.example .env
# ============================================

# ---- Server ----
NODE_ENV=development
PORT=5000
API_VERSION=v1
CLIENT_URL=http://localhost:3000

# ---- MongoDB ----
MONGODB_URI=mongodb://localhost:27017/dreamhouse

# ---- JWT ----
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRE_IN=15m
JWT_REFRESH_EXPIRE_IN=7d

# ---- Redis (optional) ----
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- AWS S3 (optional) ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=buildmyhome-uploads
AWS_S3_ENDPOINT=

# ---- Payment Gateways (optional) ----
RAZORPAY_KEY_ID=
RAZORPAY_SECRET=
STRIPE_SECRET_KEY=

# ---- Email / SMTP (optional for dev) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@buildmyhome.com
EMAIL_FROM_NAME=BuildMyHome

# ---- Rate Limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ---- File Upload ----
MAX_FILE_SIZE=52428800
MAX_IMAGES_PER_UPLOAD=10

# ---- Logging ----
LOG_LEVEL=info
LOG_DIR=logs

